{
  "classNaming": {
    "patternsDoc": "docs/CLASS-NAMING.md",
    "shippedTypesDoc": "docs/CLASS-DESIGN.md",
    "suffixRule": "csharp-class-suffix-patterns.mdc"
  },
  "productionTestSeams": {
    "rule": "unity-test-seams.mdc"
  },
  "commonPitfalls": {
    "rule": "unity-common-pitfalls.mdc",
    "pathGlobs": [
      "Assets/Scripts/**/*.cs",
      "Assets/Tests/**/*.cs",
      "Assets/PlayModeTests/**/*.cs"
    ]
  },
  "uiGotchas": {
    "centralizedDoc": "docs/UI-GOTCHAS.md",
    "presentationShellDoc": "docs/SHELL-GOTCHAS.md",
    "pathGlobs": [
      "Assets/Scripts/**/UI/**",
      "Assets/UI/**"
    ],
    "rules": [
      "centralized-ui-services.mdc"
    ]
  }
}
